# Local only. Never commit credentials. Configure Preview and Production separately.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# A random secret (openssl rand -base64 32); required before admin authentication.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google account emails explicitly permitted to administer the app.
ADMIN_EMAILS=
# Canonical deployed origin, e.g. https://your-domain.example
AUTH_URL=http://localhost:3000
# Orders are saved with notifications pending when email is not configured.
RESEND_API_KEY=
ORDER_EMAIL=
EMAIL_FROM=
# Route worker authorization. Schedule /api/jobs/email externally or with Vercel Cron.
CRON_SECRET=
# Only production sends email. Preview/test can set EMAIL_TEST_TO to a controlled inbox.
EMAIL_TEST_TO=
