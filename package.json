{
  "name": "terranova-orderform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src scripts tests next.config.ts tsconfig.json package.json README.md",
    "test": "tsx --test tests/*.test.ts",
    "db:inspect": "node --env-file=.env.local scripts/inspect-db.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file=.env.local scripts/import-sheets.mjs"
  },
  "dependencies": {
    "next": "^16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.15",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
